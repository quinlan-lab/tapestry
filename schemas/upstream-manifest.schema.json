{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quinlan-lab/tapestry/schemas/upstream-manifest.schema.json",
  "title": "Tapestry canonical PacBio WDL output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "workflow",
    "family_id",
    "joint_small_variants",
    "samples"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"const": "pacbio_hifi_human_wgs_wdl"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "release", "commit"],
      "properties": {
        "name": {"const": "humanwgs_family"},
        "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "family_id": {"type": "string", "minLength": 1},
    "joint_small_variants": {"$ref": "#/$defs/indexedVcf"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "outputs_manifest": {"$ref": "#/$defs/path"},
        "metadata": {"$ref": "#/$defs/path"}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1},
    "indexedVcf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcf", "index"],
      "properties": {
        "vcf": {"type": "string", "minLength": 1, "pattern": "\\.vcf\\.gz$"},
        "index": {"type": "string", "minLength": 1, "pattern": "\\.vcf\\.gz\\.tbi$"}
      }
    },
    "indexedBed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bed", "index"],
      "properties": {
        "bed": {"type": "string", "minLength": 1, "pattern": "\\.bed\\.gz$"},
        "index": {"type": "string", "minLength": 1, "pattern": "\\.bed\\.gz\\.tbi$"}
      }
    },
    "indexedBam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bam", "index"],
      "properties": {
        "bam": {"type": "string", "minLength": 1, "pattern": "\\.bam$"},
        "index": {"type": "string", "minLength": 1, "pattern": "\\.bai$"}
      }
    },
    "cpgModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combined", "hap1", "hap2"],
      "properties": {
        "combined": {"$ref": "#/$defs/indexedBed"},
        "hap1": {"$ref": "#/$defs/indexedBed"},
        "hap2": {"$ref": "#/$defs/indexedBed"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phased_small_variants", "phase_blocks", "cpg_model"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phased_small_variants": {
          "oneOf": [{"$ref": "#/$defs/indexedVcf"}, {"type": "null"}]
        },
        "phase_blocks": {
          "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
        },
        "cpg_model": {
          "oneOf": [{"$ref": "#/$defs/cpgModel"}, {"type": "null"}]
        },
        "phase_stats": {
          "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
        },
        "phase_haplotags": {
          "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
        },
        "haplotagged_bam": {
          "oneOf": [{"$ref": "#/$defs/indexedBam"}, {"type": "null"}]
        }
      }
    }
  }
}
