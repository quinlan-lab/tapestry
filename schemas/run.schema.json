{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quinlan-lab/tapestry/schemas/run.schema.json",
  "title": "Tapestry run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "project",
    "pedigree",
    "reference",
    "upstream",
    "inheritance",
    "methylation",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "pedigree"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outdir"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "outdir": {"$ref": "#/$defs/path"}
      }
    },
    "pedigree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ped"],
      "properties": {"ped": {"$ref": "#/$defs/path"}}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fasta", "fasta_index"],
      "properties": {
        "name": {"const": "GRCh38"},
        "fasta": {"$ref": "#/$defs/path"},
        "fasta_index": {"$ref": "#/$defs/path"},
        "fasta_gzi": {"$ref": "#/$defs/path"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": {"$ref": "#/$defs/path"},
        "allow_unaudited_release": {"type": "boolean", "default": false}
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "map", "concordance"],
      "properties": {
        "method": {"const": "gtg"},
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_qual", "min_depth", "min_run_markers"],
          "properties": {
            "min_qual": {"type": "number", "minimum": 0},
            "min_depth": {"type": "integer", "minimum": 0},
            "min_run_markers": {"type": "integer", "minimum": 1}
          }
        },
        "concordance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_qual", "min_depth"],
          "properties": {
            "min_qual": {"type": "number", "minimum": 0},
            "min_depth": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "methylation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "min_coverage", "mismatch_window_bp"],
      "properties": {
        "modes": {
          "type": "array",
          "prefixItems": [{"const": "model"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "min_coverage": {"type": "integer", "minimum": 1},
        "mismatch_window_bp": {"type": "integer", "minimum": 0}
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/autosome"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bigwig"],
      "properties": {"bigwig": {"type": "boolean"}}
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1},
    "autosome": {
      "type": "string",
      "enum": [
        "chr1", "chr2", "chr3", "chr4", "chr5", "chr6", "chr7",
        "chr8", "chr9", "chr10", "chr11", "chr12", "chr13", "chr14",
        "chr15", "chr16", "chr17", "chr18", "chr19", "chr20", "chr21",
        "chr22"
      ]
    }
  }
}
