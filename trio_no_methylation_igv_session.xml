<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  IGV session for inspecting trio phasing: the joint phased VCF, the
  haplotagged BAMs and pedMEC phase blocks for the trio (NA12878 kid,
  NA12891 dad, NA12892 mom), plus the kid's parent-phased hap-map blocks
  and bit-vector mismatch sites. DNA methylation tracks are intentionally
  omitted.

  Serve the data, then tunnel from your laptop. On the host holding the
  data, run serve_data_for_igv.py with port 8000 and the data-dir flag
  pointing at the directory that contains pedmec-phasing/ and
  dna-methylation/ (dev or production: the session does not care which,
  it only sees the served paths); on your laptop run
  ssh -L 8000:localhost:8000 to that host; then File then Open Session and
  pick this file.

  Example use, confirm a candidate meiotic crossover: navigate to the
  candidate site and look for a SHARP sparse-to-dense transition in ONE of
  the kid's bit-vector mismatch tracks (paternal or maternal) while the
  OTHER stays FLAT across the same spot (a true parental crossover, not a
  kid phase-switch, which would transition in BOTH tracks at the same
  coordinate). The session opens at chr14:~16.09 Mb (NA12878), where the
  pedMEC phase blocks show interleaved/nested phase sets; navigate anywhere.
-->
<Session genome="hg38" locus="chr14:16,060,275-16,117,246" version="8">
    <Resources>
        <!-- PedMEC-phasing: phased VCF (tabix .tbi so IGV range-requests the window
             instead of downloading the genome-wide file) -->
        <Resource path="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.vcf.gz" index="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.vcf.gz.tbi" type="vcf"/>
        <!-- PedMEC-phasing: phase blocks (GTF). No index: pedMEC blocks are few
             (KB-sized genome-wide), so IGV builds an in-memory index from the
             whole file. The pipeline does not produce a .gtf.idx, and pointing
             at a non-existent one makes IGV fail instead of falling back. -->
        <Resource path="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12878.blocks.gtf" type="gtf"/>
        <Resource path="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12891.blocks.gtf" type="gtf"/>
        <Resource path="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12892.blocks.gtf" type="gtf"/>
        <!-- PedMEC-phasing: haplotagged BAMs (.bai) -->
        <Resource path="http://localhost:8000/pedmec-phasing/NA12878.GRCh38.haplotagged.bam" index="http://localhost:8000/pedmec-phasing/NA12878.GRCh38.haplotagged.bam.bai" type="bam"/>
        <Resource path="http://localhost:8000/pedmec-phasing/NA12891.GRCh38.haplotagged.bam" index="http://localhost:8000/pedmec-phasing/NA12891.GRCh38.haplotagged.bam.bai" type="bam"/>
        <Resource path="http://localhost:8000/pedmec-phasing/NA12892.GRCh38.haplotagged.bam" index="http://localhost:8000/pedmec-phasing/NA12892.GRCh38.haplotagged.bam.bai" type="bam"/>
        <!-- Parent-phased: kid hap-map blocks (bgzipped + tabix .tbi) -->
        <Resource path="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.paternal.sorted.bed.gz" index="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.paternal.sorted.bed.gz.tbi"/>
        <Resource path="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.maternal.sorted.bed.gz" index="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.maternal.sorted.bed.gz.tbi"/>
        <!-- Parent-phased: kid bit-vector mismatch sites (tabix .tbi) -->
        <Resource path="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.paternal.vcf.gz" index="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.paternal.vcf.gz.tbi" type="vcf"/>
        <Resource path="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.maternal.vcf.gz" index="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.maternal.vcf.gz.tbi" type="vcf"/>
    </Resources>
    <!-- Phased VCF -->
    <Panel height="80" name="DataPanel" width="2163">
        <Track attributeKey="CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.vcf.gz" clazz="org.broad.igv.variant.VariantTrack" displayMode="EXPANDED" fontSize="10" height="60" id="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.vcf.gz" name="CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.vcf.gz" siteColorMode="ALLELE_FREQUENCY" visible="true"/>
    </Panel>
    <!-- Kid (NA12878): BAM + hap-map blocks + bit-vector mismatch tracks -->
    <Panel height="500" name="PanelKid" width="2163">
        <Track attributeKey="NA12878.GRCh38.haplotagged.bam Coverage" clazz="org.broad.igv.sam.CoverageTrack" fontSize="10" id="http://localhost:8000/pedmec-phasing/NA12878.GRCh38.haplotagged.bam_coverage" name="NA12878 Coverage" visible="false"/>
        <Track attributeKey="NA12878.GRCh38.haplotagged.bam" clazz="org.broad.igv.sam.AlignmentTrack" color="185,185,185" displayMode="SQUISHED" experimentType="THIRD_GEN" fontSize="10" height="150" id="http://localhost:8000/pedmec-phasing/NA12878.GRCh38.haplotagged.bam" name="NA12878 BAM" visible="true">
            <RenderOptions colorByTag="PS" colorOption="TAG" groupByOption="PHASE" hideSmallIndels="true" smallIndelThreshold="100"/>
        </Track>
        <Track attributeKey="NA12878.hap-map-blocks.paternal.sorted.bed.gz" clazz="org.broad.igv.track.FeatureTrack" displayMode="EXPANDED" fontSize="10" id="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.paternal.sorted.bed.gz" name="NA12878 hap-map blks pat" visible="true"/>
        <Track attributeKey="NA12878.hap-map-blocks.maternal.sorted.bed.gz" clazz="org.broad.igv.track.FeatureTrack" displayMode="EXPANDED" fontSize="10" id="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.hap-map-blocks.maternal.sorted.bed.gz" name="NA12878 hap-map blks mat" visible="true"/>
        <Track attributeKey="NA12878.bit-vector-sites-mismatches.paternal.vcf.gz" clazz="org.broad.igv.variant.VariantTrack" displayMode="COLLAPSED" fontSize="10" id="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.paternal.vcf.gz" name="NA12878 bitvec mismatch pat" visible="true" showGenotypes="false"/>
        <Track attributeKey="NA12878.bit-vector-sites-mismatches.maternal.vcf.gz" clazz="org.broad.igv.variant.VariantTrack" displayMode="COLLAPSED" fontSize="10" id="http://localhost:8000/dna-methylation/CEPH1463.GRCh38.hifi.parent-phased/NA12878.bit-vector-sites-mismatches.maternal.vcf.gz" name="NA12878 bitvec mismatch mat" visible="true" showGenotypes="false"/>
    </Panel>
    <!-- Dad (NA12891): BAM -->
    <Panel height="200" name="PanelDad" width="2163">
        <Track attributeKey="NA12891.GRCh38.haplotagged.bam Coverage" clazz="org.broad.igv.sam.CoverageTrack" fontSize="10" id="http://localhost:8000/pedmec-phasing/NA12891.GRCh38.haplotagged.bam_coverage" name="NA12891 Coverage" visible="false"/>
        <Track attributeKey="NA12891.GRCh38.haplotagged.bam" clazz="org.broad.igv.sam.AlignmentTrack" color="185,185,185" displayMode="SQUISHED" experimentType="THIRD_GEN" fontSize="10" height="150" id="http://localhost:8000/pedmec-phasing/NA12891.GRCh38.haplotagged.bam" name="NA12891 BAM" visible="true">
            <RenderOptions colorByTag="PS" colorOption="TAG" groupByOption="PHASE" hideSmallIndels="true" smallIndelThreshold="100"/>
        </Track>
    </Panel>
    <!-- Mom (NA12892): BAM -->
    <Panel height="200" name="PanelMom" width="2163">
        <Track attributeKey="NA12892.GRCh38.haplotagged.bam Coverage" clazz="org.broad.igv.sam.CoverageTrack" fontSize="10" id="http://localhost:8000/pedmec-phasing/NA12892.GRCh38.haplotagged.bam_coverage" name="NA12892 Coverage" visible="false"/>
        <Track attributeKey="NA12892.GRCh38.haplotagged.bam" clazz="org.broad.igv.sam.AlignmentTrack" color="185,185,185" displayMode="SQUISHED" experimentType="THIRD_GEN" fontSize="10" height="150" id="http://localhost:8000/pedmec-phasing/NA12892.GRCh38.haplotagged.bam" name="NA12892 BAM" visible="true">
            <RenderOptions colorByTag="PS" colorOption="TAG" groupByOption="PHASE" hideSmallIndels="true" smallIndelThreshold="100"/>
        </Track>
    </Panel>
    <!-- Feature panel: phase blocks + reference -->
    <Panel height="200" name="FeaturePanel" width="2163">
        <Track attributeKey="Reference sequence" clazz="org.broad.igv.track.SequenceTrack" fontSize="10" id="Reference sequence" name="Reference sequence" sequenceTranslationStrandValue="+" shouldShowTranslation="false" visible="true"/>
        <Track attributeKey="CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12878.blocks.gtf" clazz="org.broad.igv.track.FeatureTrack" displayMode="EXPANDED" fontSize="10" id="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12878.blocks.gtf" name="NA12878 phase blocks" visible="true"/>
        <Track attributeKey="CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12891.blocks.gtf" clazz="org.broad.igv.track.FeatureTrack" displayMode="EXPANDED" fontSize="10" id="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12891.blocks.gtf" name="NA12891 phase blocks" visible="true"/>
        <Track attributeKey="CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12892.blocks.gtf" clazz="org.broad.igv.track.FeatureTrack" displayMode="EXPANDED" fontSize="10" id="http://localhost:8000/pedmec-phasing/CEPH-1463.joint.GRCh38.deepvariant.glnexus.phased.NA12892.blocks.gtf" name="NA12892 phase blocks" visible="true"/>
    </Panel>
    <HiddenAttributes>
        <Attribute name="DATA FILE"/>
        <Attribute name="DATA TYPE"/>
        <Attribute name="NAME"/>
    </HiddenAttributes>
</Session>
