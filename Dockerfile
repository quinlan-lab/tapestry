ARG RUST_IMAGE=rust:1.95.0-bookworm
ARG PYTHON_IMAGE=python:3.11.13-slim-bookworm
# Use the versioned archive: UCSC periodically replaces the unversioned binary.
ARG BEDGRAPH_TO_BIGWIG_URL=https://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64.v479/bedGraphToBigWig
ARG BEDGRAPH_TO_BIGWIG_SHA256=22baf42aa4f01fa66a74a4d77afc6bbf5bc8354978aa2b7251a18ef9a1cc3c89

FROM ${RUST_IMAGE} AS gtg-builder

ARG GTG_COMMIT=e12aca6b49ee7208952467db4a2a9e2f79b98efb

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        git \
        libbz2-dev \
        libclang-dev \
        libcurl4-openssl-dev \
        liblzma-dev \
        libssl-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none \
        https://github.com/Platinum-Pedigree-Consortium/Platinum-Pedigree-Inheritance.git \
        /build/gtg \
    && git -C /build/gtg checkout --detach "${GTG_COMMIT}"

COPY containers/gtg.Cargo.lock /build/gtg/code/rust/Cargo.lock

RUN cargo build \
      --manifest-path /build/gtg/code/rust/Cargo.toml \
      --locked \
      --release \
      --bin gtg-ped-map \
      --bin gtg-concordance


FROM ${PYTHON_IMAGE} AS python-deps-builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        libbz2-dev \
        libcurl4-openssl-dev \
        liblzma-dev \
        libssl-dev \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /opt/tapestry/requirements.txt

# The PyPI wheels for pysam and cyvcf2 bundle Red Hat-patched OpenSSL
# libraries that abort when an Apptainer container runs on a FIPS-enabled
# host. Build just these two packages from source so their bundled HTSlib
# implementations use the base image's system libraries instead.
ENV CYVCF2_HTSLIB_MODE=BUILTIN \
    PIP_DEFAULT_TIMEOUT=30 \
    PIP_RETRIES=5
RUN python -m pip wheel \
      --wheel-dir /opt/tapestry/wheels \
      --no-binary=pysam,cyvcf2 \
      --requirement /opt/tapestry/requirements.txt


FROM ${PYTHON_IMAGE} AS python-deps-installer

COPY requirements.txt /opt/tapestry/requirements.txt
COPY --from=python-deps-builder /opt/tapestry/wheels /opt/tapestry/wheels
RUN python -m pip install \
      --no-cache-dir \
      --no-index \
      --find-links=/opt/tapestry/wheels \
      --target=/opt/tapestry/site-packages \
      --requirement /opt/tapestry/requirements.txt \
    && rm -rf /opt/tapestry/wheels


FROM ${PYTHON_IMAGE} AS base-runtime

ARG GTG_COMMIT=e12aca6b49ee7208952467db4a2a9e2f79b98efb
ARG BEDGRAPH_TO_BIGWIG_URL
ARG BEDGRAPH_TO_BIGWIG_SHA256
LABEL org.opencontainers.image.source="https://github.com/quinlan-lab/tapestry"
LABEL org.opencontainers.image.description="Tapestry generic pedigree/model-only runtime"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.gtg.commit="${GTG_COMMIT}"
LABEL org.opencontainers.image.ucsc-bedGraphToBigWig.sha256="${BEDGRAPH_TO_BIGWIG_SHA256}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bcftools \
        ca-certificates \
        curl \
        libbz2-1.0 \
        libcurl4 \
        liblzma5 \
        libssl3 \
        procps \
        tabix \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Retain the legacy UCSC generator as a pinned parity oracle for the pyBigWig
# migration test. Production BigWigs are generated by pyBigWig.
RUN curl --fail --location --output /usr/local/bin/bedGraphToBigWig \
        "${BEDGRAPH_TO_BIGWIG_URL}" \
    && echo "${BEDGRAPH_TO_BIGWIG_SHA256}  /usr/local/bin/bedGraphToBigWig" \
        | sha256sum --check --strict \
    && chmod 0755 /usr/local/bin/bedGraphToBigWig

COPY requirements.txt /opt/tapestry/requirements.txt
COPY --from=python-deps-installer \
     /opt/tapestry/site-packages \
     /usr/local/lib/python3.11/site-packages
COPY --from=python-deps-installer /opt/tapestry/site-packages/bin/ /usr/local/bin/
RUN python -m pip check

# Guard the FIPS-host portability invariant: neither HTSlib binding may
# reintroduce a private OpenSSL library through a binary PyPI wheel.
RUN bundled_crypto="$(find /usr/local/lib/python3.11/site-packages \
        -type f \( \
          -path '*/pysam.libs/libcrypto*' \
          -o -path '*/cyvcf2.libs/libcrypto*' \
        \) -print)" \
    && if [ -n "${bundled_crypto}" ]; then \
         echo "Unexpected bundled OpenSSL libraries:" >&2; \
         echo "${bundled_crypto}" >&2; \
         exit 1; \
       fi

COPY --from=gtg-builder /build/gtg/code/rust/target/release/gtg-ped-map /usr/local/bin/gtg-ped-map
COPY --from=gtg-builder /build/gtg/code/rust/target/release/gtg-concordance /usr/local/bin/gtg-concordance
COPY src /opt/tapestry/src

ENV PYTHONPATH=/opt/tapestry/src:/opt/tapestry/src/util

RUN gtg-ped-map --version \
    && gtg-concordance --version \
    && test -x /usr/local/bin/bedGraphToBigWig \
    && bcftools --version \
    && python /opt/tapestry/src/tapestry_validate.py --help \
    && python /opt/tapestry/src/filter_model_beds.py --help \
    && python /opt/tapestry/src/normalize_joint_vcf.py --help \
    && python /opt/tapestry/src/run_gtg_inheritance.py --help \
    && python /opt/tapestry/src/plot_haplotype_ancestry.py --help \
    && python /opt/tapestry/src/summarize_haplotype_methylation.py --help \
    && python /opt/tapestry/src/summarize_transmission_methylation.py --help \
    && python /opt/tapestry/src/capture_versions.py --help \
    && python /opt/tapestry/src/generate_reference_cpgs.py --help \
    && python /opt/tapestry/src/phase_meth_to_founder_haps.py --help \
    && python /opt/tapestry/src/expand_model_to_all_cpgs.py --help \
    && python /opt/tapestry/src/write_results_manifest.py --help

WORKDIR /work


# Reuse the compiler toolchain to build the pinned samtools executable.
FROM python-deps-builder AS samtools-builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends bzip2 curl \
    && rm -rf /var/lib/apt/lists/*

ARG SAMTOOLS_URL=https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2
ARG SAMTOOLS_SHA256=05724b083a6b6f0305fcae5243a056cc36cf826309c3cb9347a6b89ee3fc5ada
RUN curl --fail --location --output /tmp/samtools.tar.bz2 "${SAMTOOLS_URL}" \
    && echo "${SAMTOOLS_SHA256}  /tmp/samtools.tar.bz2" | sha256sum --check --strict \
    && mkdir /build-samtools \
    && tar -xjf /tmp/samtools.tar.bz2 -C /build-samtools --strip-components=1 \
    && cd /build-samtools \
    && ./configure --prefix=/opt/samtools --without-curses \
    && make -j2 samtools \
    && install -D samtools /opt/samtools/bin/samtools


FROM base-runtime AS runtime

# Both the pb-CpG-tools release and the UCSC parity binary are Linux x86-64.
ARG TARGETARCH
RUN test "${TARGETARCH}" = amd64
ARG PB_CPG_TOOLS_URL=https://github.com/PacificBiosciences/pb-CpG-tools/releases/download/v3.0.0/pb-CpG-tools-v3.0.0-x86_64-unknown-linux-gnu.tar.gz
ARG PB_CPG_TOOLS_SHA256=44dc20510edea261ff8db81e5cd13719056ce38c61a99319b14fb9ec55e63a18
LABEL org.opencontainers.image.description="Tapestry trio and pedigree methylation runtime"
LABEL org.opencontainers.image.pb-CpG-tools.sha256="${PB_CPG_TOOLS_SHA256}"

COPY --from=samtools-builder /opt/samtools/bin/samtools /usr/local/bin/samtools
COPY --from=samtools-builder /build-samtools/LICENSE /usr/local/share/licenses/samtools/LICENSE
COPY --from=samtools-builder /build-samtools/htslib-1.21/LICENSE /usr/local/share/licenses/samtools/HTSlib-LICENSE
COPY --from=samtools-builder /build-samtools/lz4/LICENSE /usr/local/share/licenses/samtools/LZ4-LICENSE
RUN curl --fail --location --output /tmp/pb-CpG-tools.tar.gz "${PB_CPG_TOOLS_URL}" \
    && echo "${PB_CPG_TOOLS_SHA256}  /tmp/pb-CpG-tools.tar.gz" | sha256sum --check --strict \
    && mkdir /opt/pb-CpG-tools \
    && tar -xzf /tmp/pb-CpG-tools.tar.gz -C /opt/pb-CpG-tools --strip-components=1 \
    && ln -s /opt/pb-CpG-tools/bin/aligned_bam_to_cpg_scores /usr/local/bin/aligned_bam_to_cpg_scores \
    && rm /tmp/pb-CpG-tools.tar.gz \
    && samtools --version \
    && test "$(python -m whatshap --version)" = 2.8 \
    && aligned_bam_to_cpg_scores --version \
    && python /opt/tapestry/src/phase_meth_to_parent_haps.py --help \
    && python /opt/tapestry/src/trio_model_methylation.py --help
